{
  "name": "kairos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "verify:fast": "npm run lint && npm run typecheck && npm run test && npm run test:activity-verifier && npm run test:vercel-env",
    "verify": "npm run compact:compile && npm run test:contracts && npm run verify:fast && npm run build",
    "proof:up": "docker compose -f infra/midnight/proof-server.yml up -d",
    "proof:down": "docker compose -f infra/midnight/proof-server.yml down",
    "proof:logs": "docker compose -f infra/midnight/proof-server.yml logs -f proof-server",
    "proof:status": "node scripts/midnight/check-proof-server.mjs",
    "proof:smoke": "node scripts/midnight/smoke-local-proofs.mjs",
    "verify:preprod": "node scripts/midnight/verify-preprod-deployment.mjs",
    "verify:activity": "node scripts/midnight/verify-preprod-activity.mjs",
    "test:activity-verifier": "node --test tests/node/preprod-activity.test.mjs",
    "test:vercel-env": "node --test tests/node/vercel-env.test.mjs",
    "compact:version": "compact compile --version",
    "compact:compile": "node scripts/midnight/compile-contracts.mjs",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.1",
    "@polkadot/api": "16.5.6",
    "bip39": "^3.1.0",
    "lightweight-charts": "5.2.1",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}

// ============================================================================
// KAIROS — Confidential, self-rebalancing DeFi treasury
// ============================================================================
//
// KAIROS runs a repeated decision market over how a protocol-owned treasury
// should be allocated between two quote-side assets (Token A and Token B).
// Participants privately express conviction for one side; when the market
// resolves, the treasury's target allocation is moved deterministically toward
// the winning side. A protocol-controlled flip converts between A and B and
// skims an asymmetric directional tax that accrues to the treasury.
//
// ------------------------------- WHAT IS PUBLIC ------------------------------
// Every `export ledger` field below is public chain state. Concretely an
// observer can read:
//   - marketId, marketState            : which market and which lifecycle stage
//   - allocA / allocB                  : treasury target allocation in basis
//                                        points (invariant allocA + allocB = 10000)
//   - reserveA / reserveB              : treasury demo-asset accounting balances
//   - taxRateAtoB / taxRateBtoA        : the configured directional tax rates
//   - taxCollectedA / taxCollectedB    : cumulative tax revenue retained
//   - commitments[nullifier]           : an opaque 32-byte hash, and the
//                                        nullifier it is filed under
//   - revealedAt[nullifier]            : whether a commitment has been revealed
//   - tallyA / tallyB                  : the revealed conviction totals
//   - positionCount                    : how many commitments were posted
//   - winner, lastRebalanceBps         : the resolved outcome and move size
//
// ------------------------------- WHAT IS PRIVATE -----------------------------
// These never enter public state and are supplied as witnesses. They exist only
// inside the user's browser during proof generation:
//   - localSecret()   : a per-user secret that derives the market nullifier
//   - positionSide()  : which side the user backs (0 = A, 1 = B)
//   - positionWeight() : the conviction weight the user attaches
//   - positionNonce() : salt that makes the commitment hiding
//
// While a market is OPEN the only thing that reaches the chain is
//   nullifier   = H("kairos:nullifier:v1", localSecret, marketId)
//   commitment  = H("kairos:commitment:v1", marketId, side, weight, nonce)
// Both are preimage-resistant hashes, so side, weight and nonce are not
// recoverable from chain state during the submission phase.
//
// ------------------------------- WHAT IS PROVED ------------------------------
// Each circuit call produces a zero-knowledge proof that:
//   - the caller knows a (side, weight, nonce) opening the commitment they
//     filed, without revealing that opening;
//   - side is a valid enum value and weight lies inside the accepted range;
//   - the nullifier is well-formed for this market, so a position cannot be
//     replayed and cannot be re-filed under a different commitment.
//
// --------------------------- WHAT IS DISCLOSED, AND WHEN ---------------------
// Commitment openings are NOT disclosed at submission time. They become public
// only when the participant calls revealPosition (state CLOSED), because the
// tally that decides the market has to be computable from public state. Every
// value that leaves the private domain does so through an explicit disclose()
// call, and each one is annotated below with the reason it is necessary.
//
// KNOWN LIMITATION (documented rather than hidden): KAIROS is commit-reveal,
// not commit-forever. side and weight are private while the market is OPEN and
// become public at reveal. The nullifier is unlinkable across markets because
// marketId is folded into it. See docs/USAGE.md and PROPOSAL.md.
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

export enum MarketState {
  OPEN,      // commitments accepted
  CLOSED,    // commitments frozen, reveals accepted
  SETTLED,   // winner resolved and treasury reallocated
  FINALIZED  // market closed out, ready for the next one
}

export enum Side {
  NONE, // no winner (a tied market reallocates nothing)
  A,
  B
}

// ---------------------------------------------------------------------------
// Public ledger state
// ---------------------------------------------------------------------------

/// Monotonic market counter. Folded into nullifiers and commitments so that
/// per-market records never collide and no Map reset is ever required.
export ledger marketId: Uint<64>;

/// Lifecycle stage. Enforced by every state-transition circuit.
export ledger marketState: MarketState;

/// Treasury target allocation, in basis points. Invariant: allocA + allocB == 10000.
export ledger allocA: Uint<64>;
export ledger allocB: Uint<64>;

/// Treasury demo-asset accounting balances. These are clearly-labelled demo
/// units, not real assets — see README "Asset accounting".
export ledger reserveA: Uint<64>;
export ledger reserveB: Uint<64>;

/// Directional flip tax rates, in basis points of the flipped amount.
export ledger taxRateAtoB: Uint<64>;
export ledger taxRateBtoA: Uint<64>;

/// Cumulative tax revenue retained by the treasury, in each asset's units.
export ledger taxCollectedA: Uint<64>;
export ledger taxCollectedB: Uint<64>;

/// nullifier -> commitment. Map keys are preimage-resistant and per-market,
/// so this doubles as the replay-protection set.
export ledger commitments: Map<Bytes<32>, Bytes<32>>;

/// nullifier -> marketId, marking a commitment as already revealed.
export ledger revealedAt: Map<Bytes<32>, Uint<64>>;

/// Revealed conviction totals per side.
export ledger tallyA: Uint<64>;
export ledger tallyB: Uint<64>;

/// Number of commitments posted for the current market.
export ledger positionCount: Uint<64>;

/// Resolved outcome of the most recent settlement.
export ledger winner: Side;

/// How many basis points the treasury moved at the last settlement.
export ledger lastRebalanceBps: Uint<64>;

// ---------------------------------------------------------------------------
// Private witnesses — supplied by the browser, never written to public state
// ---------------------------------------------------------------------------

witness localSecret(): Bytes<32>;
witness positionSide(): Uint<64>;
witness positionWeight(): Uint<64>;
witness positionNonce(): Bytes<32>;

// Compact has no integer division operator. Division is therefore delegated to
// this witness, which computes quotient and remainder off-chain. checkedDiv
// re-establishes the result on-chain from public values, so a dishonest witness
// cannot influence the outcome — see the verification in checkedDiv below.
//
// This witness never sees private data: it is only ever called on values that
// are already public (flip amounts and tax rates).
witness divMod(x: Uint<64>, y: Uint<64>): [Uint<64>, Uint<64>];

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

// Allocation arithmetic is in basis points: 10000 bps == 100%.
circuit totalBps(): Uint<64> {
  return 10000;
}

// Compact infers a widened type for Uint arithmetic and requires an explicit
// cast back down. Routing every ledger update through these two helpers does
// two things: it keeps the casts in one place, and it makes the failure mode
// explicit — the narrowing cast is runtime-checked, so a result that would
// overflow or underflow fails proof generation instead of silently wrapping and
// corrupting treasury accounting.
circuit addU64(a: Uint<64>, b: Uint<64>): Uint<64> {
  return (a + b) as Uint<64>;
}

circuit subU64(a: Uint<64>, b: Uint<64>): Uint<64> {
  assert(a >= b, "KAIROS: unsigned underflow");
  return (a - b) as Uint<64>;
}

circuit mulU64(a: Uint<64>, b: Uint<64>): Uint<64> {
  return (a * b) as Uint<64>;
}

// Upper bound on how far the treasury will ever tilt toward one side.
circuit allocCeilingBps(): Uint<64> {
  return 9000;
}

// Size of a single reallocation step, in basis points (20 percentage points).
// A plain additive step keeps the whole rule free of division, and the ceiling
// check in rebalancedTo is what keeps it inside bounds.
circuit rebalanceStepBps(): Uint<64> {
  return 2000;
}

// Accepted conviction weight range, inclusive.
circuit minWeight(): Uint<64> {
  return 1;
}

circuit maxWeight(): Uint<64> {
  return 1000000;
}

// A commitment opening is only ever disclosed as a hash. The domain separator
// keeps KAIROS hashes from colliding with any other protocol's preimages.
circuit commitmentFor(side: Uint<64>, weight: Uint<64>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "kairos:commitment:v1"),
    marketId as Field as Bytes<32>,
    side as Field as Bytes<32>,
    weight as Field as Bytes<32>,
    nonce
  ]);
}

// marketId is folded in, so a nullifier is single-use per market and carries no
// linkability across markets.
circuit nullifierFor(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "kairos:nullifier:v1"),
    secret,
    marketId as Field as Bytes<32>
  ]);
}

// Deterministic treasury reallocation: advance the winning side by one fixed
// step, saturating at the ceiling. The loser always receives exactly the
// remainder, which preserves allocA + allocB == 10000 by construction.
//   current 5000 -> 5000 + 2000 = 7000   (loser 3000)
//   current 7000 -> 7000 + 2000 = 9000   (loser 1000)
//   current 9000 -> already at the ceiling, stays 9000
circuit rebalancedTo(current: Uint<64>): Uint<64> {
  const stepped = current + rebalanceStepBps();
  if (stepped > allocCeilingBps()) {
    return allocCeilingBps();
  } else {
    // Safe narrowing: this branch is only reached when stepped <= ceiling, so
    // the value is already known to fit.
    return stepped as Uint<64>;
  }
}

// The losing side always takes exactly the remainder of the total, which is
// what makes allocA + allocB == 10000 hold after every reallocation. The
// explicit assertion is what rules out unsigned underflow here.
circuit complementOf(part: Uint<64>): Uint<64> {
  assert(part <= totalBps(), "KAIROS: allocation exceeds total");
  return (totalBps() - part) as Uint<64>;
}

// Size of a reallocation, for reporting. Never negative: the winner is only
// ever advanced, never reduced.
circuit rebalanceSize(before: Uint<64>, after: Uint<64>): Uint<64> {
  assert(after >= before, "KAIROS: reallocation moved backwards");
  return (after - before) as Uint<64>;
}

// Division, built on the divMod witness and fully re-verified on-chain.
//
// A dishonest witness cannot corrupt the result: any (q, r) it returns must
// satisfy r < y and q * y + r == x, and the q <= x bound rules out the
// modular-arithmetic wrap-around that would otherwise let an oversized quotient
// satisfy that equation. With y == 10000 and the bounded x values used below,
// q * y cannot overflow Uint<64>.
circuit checkedDiv(x: Uint<64>, y: Uint<64>): Uint<64> {
  assert(y != 0, "KAIROS: division by zero");

  const qr = divMod(x, y);
  const q = qr[0];
  const r = qr[1];

  assert(q <= x, "KAIROS: quotient out of range");
  assert(r < y, "KAIROS: remainder out of range");
  assert(addU64(mulU64(q, y), r) == x, "KAIROS: division verification failed");

  // The quotient is fully determined by the public inputs x and y and has just
  // been verified against them, so disclosing it exposes nothing beyond what
  // the caller already published.
  return disclose(q);
}

// ---------------------------------------------------------------------------
// Initialization
// ---------------------------------------------------------------------------

constructor() {
  marketId = 1;
  marketState = MarketState.OPEN;

  allocA = 5000;
  allocB = 5000;

  // Demo accounting units. See README "Asset accounting" — these are NOT real
  // assets and no mainnet value is represented by them.
  reserveA = 1000000;
  reserveB = 1000000;

  // Asymmetric by design: 1% to move into A, 3% to move into B.
  taxRateAtoB = 100;
  taxRateBtoA = 300;

  taxCollectedA = 0;
  taxCollectedB = 0;

  tallyA = 0;
  tallyB = 0;
  positionCount = 0;

  winner = Side.NONE;
  lastRebalanceBps = 0;
}

// ---------------------------------------------------------------------------
// Market lifecycle
// ---------------------------------------------------------------------------

/// File a private position on the current market.
///
/// Consumes side, weight and nonce as witnesses and publishes only two opaque
/// hashes: the per-market nullifier (which doubles as the replay guard) and the
/// commitment. Nothing here reveals which side was chosen or how much
/// conviction was attached.
export circuit submitPosition(): Bytes<32> {
  assert(marketState == MarketState.OPEN, "KAIROS: market is not open");

  const side = positionSide();
  const weight = positionWeight();
  const nonce = positionNonce();

  // Range checks are proven in zero knowledge; on success they leak nothing.
  assert(side == 0 || side == 1, "KAIROS: side must be 0 (A) or 1 (B)");
  assert(weight >= minWeight() && weight <= maxWeight(), "KAIROS: weight out of accepted range");

  const nul = nullifierFor(localSecret());

  // Replay protection: one position per secret per market. The lookup key is
  // disclosed (it is already a hash), the secret behind it is not.
  assert(!commitments.member(disclose(nul)), "KAIROS: position already submitted for this market");

  const cm = commitmentFor(side, weight, nonce);

  // Deliberate disclosure: both values are preimage-resistant hashes. Publishing
  // them is what lets the position be verified and revealed later, and they
  // reveal neither the side nor the weight.
  commitments.insert(disclose(nul), disclose(cm));
  positionCount = addU64(positionCount, 1);

  return disclose(cm);
}

/// Freeze the market. No further commitments are accepted after this.
export circuit closeMarket(): [] {
  assert(marketState == MarketState.OPEN, "KAIROS: market is not open");
  marketState = MarketState.CLOSED;
}

/// Reveal a previously filed position so it can count toward the tally.
///
/// This is the point where side and weight become public. They are disclosed
/// through the tally update, which is the minimum disclosure needed to compute
/// a market result from public state. nonce and localSecret are never disclosed
/// — they are only ever inputs to the hash comparison below.
export circuit revealPosition(): [] {
  assert(marketState == MarketState.CLOSED, "KAIROS: market is not closed");

  // Deliberate disclosure. Reveal is the point at which a position becomes
  // public: the side decides which tally the position counts toward, so the
  // comparison against the tally can only resolve if the side is public. The
  // weight is disclosed through the tally update below, and is also required
  // for the tally to be computable. nonce and localSecret are NOT disclosed —
  // they appear only inside the hash comparison further down.
  const side = disclose(positionSide());
  const weight = positionWeight();
  const nonce = positionNonce();
  const nul = nullifierFor(localSecret());

  assert(commitments.member(disclose(nul)), "KAIROS: no position filed for this market");
  assert(!revealedAt.member(disclose(nul)), "KAIROS: position already revealed");

  // Recompute the opening and require it to match what was filed. A participant
  // cannot reveal a different side or weight than they committed to.
  const cm = commitmentFor(side, weight, nonce);
  assert(commitments.lookup(disclose(nul)) == disclose(cm), "KAIROS: reveal does not match commitment");

  if (side == 0) {
    tallyA = disclose(addU64(tallyA, weight));
  } else {
    tallyB = disclose(addU64(tallyB, weight));
  }

  revealedAt.insert(disclose(nul), disclose(marketId));
}

/// Resolve the market and reallocate the treasury toward the winning side.
///
/// A tie reallocates nothing and resolves to Side.NONE, so the outcome is
/// deterministic for every possible tally pair.
export circuit settleMarket(): [] {
  assert(marketState == MarketState.CLOSED, "KAIROS: market is not closed");

  if (tallyA > tallyB) {
    const next = rebalancedTo(allocA);
    lastRebalanceBps = rebalanceSize(allocA, next);
    allocA = next;
    allocB = complementOf(next);
    winner = Side.A;
  } else if (tallyB > tallyA) {
    const next = rebalancedTo(allocB);
    lastRebalanceBps = rebalanceSize(allocB, next);
    allocB = next;
    allocA = complementOf(next);
    winner = Side.B;
  } else {
    lastRebalanceBps = 0;
    winner = Side.NONE;
  }

  marketState = MarketState.SETTLED;
}

/// Close out a settled market. Treasury allocation is frozen at this point.
export circuit finalizeMarket(): [] {
  assert(marketState == MarketState.SETTLED, "KAIROS: market is not settled");
  marketState = MarketState.FINALIZED;
}

/// Open the next market, carrying the treasury forward.
///
/// Per-market tallies are reset; treasury allocation, reserves and accumulated
/// tax revenue persist. This is the step that closes the KAIROS loop:
/// conviction -> resolution -> reallocation -> flip -> tax -> next market.
export circuit startNextMarket(): [] {
  assert(marketState == MarketState.FINALIZED, "KAIROS: market is not finalized");

  marketId = addU64(marketId, 1);
  tallyA = 0;
  tallyB = 0;
  positionCount = 0;
  winner = Side.NONE;
  lastRebalanceBps = 0;
  marketState = MarketState.OPEN;
}

// ---------------------------------------------------------------------------
// Protocol-controlled flip with asymmetric directional tax
// ---------------------------------------------------------------------------

/// Convert treasury reserves between A and B, skimming a directional tax.
///
/// direction == 0 : A -> B, taxed at taxRateAtoB
/// direction == 1 : B -> A, taxed at taxRateBtoA
///
/// The tax is retained by the treasury (it is revenue), so only the net amount
/// actually changes hands. Accounting is 1:1 in demo units and total demo value
/// is conserved: the converted net still exists on the other side, and the tax
/// stays on the source side as tracked revenue.
///
/// Returns the net amount that was converted.
export circuit flip(direction: Uint<64>, amount: Uint<64>): Uint<64> {
  // Circuit parameters are private by default in Compact. A flip is a public
  // protocol operation, so direction and amount are disclosed once, up front,
  // and everything below then operates on public values.
  const dir = disclose(direction);
  const amt = disclose(amount);

  assert(dir == 0 || dir == 1, "KAIROS: direction must be 0 (A->B) or 1 (B->A)");
  assert(amt > 0, "KAIROS: flip amount must be positive");

  if (dir == 0) {
    // Requiring the full amount keeps the pre-tax notional available, which
    // guarantees reserveA - net >= tax >= 0 and so rules out underflow.
    assert(reserveA >= amt, "KAIROS: insufficient reserve A for this flip");

    const tax = checkedDiv(mulU64(amt, taxRateAtoB), totalBps());
    const net = subU64(amt, tax);

    reserveA = subU64(reserveA, net);
    reserveB = addU64(reserveB, net);
    taxCollectedA = addU64(taxCollectedA, tax);

    return disclose(net);
  } else {
    assert(reserveB >= amt, "KAIROS: insufficient reserve B for this flip");

    const tax = checkedDiv(mulU64(amt, taxRateBtoA), totalBps());
    const net = subU64(amt, tax);

    reserveB = subU64(reserveB, net);
    reserveA = addU64(reserveA, net);
    taxCollectedB = addU64(taxCollectedB, tax);

    return disclose(net);
  }
}

pragma language_version 0.23;
import CompactStandardLibrary;

// Public: round, phase, commitment hashes/count, winner, treasury targets,
// and the identities/supply status of the three transparent contract tokens.
// Private circuit inputs: each side and random salt. The resolver must obtain
// all eight openings; its proof server can see them. This contract does not
// authenticate unique people or escrow a financial position.
export struct Opening {
  side: Uint<8>;
  salt: Bytes<32>;
}

export struct Tally {
  index: Uint<8>;
  forA: Uint<8>;
  forB: Uint<8>;
}

// All fields are already public at the time of a treasury action. This
// append-only record keeps prior round outcomes visible after the next round.
export struct TreasuryAction {
  round: Uint<32>;
  kind: Uint<8>; // 0 resolution, 1 expiry, 2 reserve restoration
  winner: Uint<8>;
  targetA: Uint<8>;
  targetB: Uint<8>;
  reserveA: Uint<128>;
  reserveB: Uint<128>;
  feePool: Uint<128>;
}

export ledger round: Uint<32>;
export ledger roundCloseAt: Uint<64>; // public Unix seconds, chosen at deployment
export ledger commitments: Map<Uint<8>, Bytes<32>>;
export ledger nextIndex: Uint<8>;
export ledger phase: Uint<8>; // 0 open, 1 full, 2 resolved
export ledger winner: Uint<8>; // 0 quote A, 1 quote B, 2 none/tie
export ledger targetA: Uint<8>; // percentage policy, not executed liquidity
export ledger targetB: Uint<8>;
export ledger economyIssued: Boolean;
export ledger quoteAColor: Bytes<32>;
export ledger quoteBColor: Bytes<32>;
export ledger kaiColor: Bytes<32>;
export ledger reserveA: Uint<128>; // NIGHT allocated to quote A redemptions
export ledger reserveB: Uint<128>; // NIGHT allocated to quote B redemptions
export ledger feePool: Uint<128>; // NIGHT retained by the protocol
export ledger kaiDistributed: Uint<128>; // public total paid from fixed genesis inventory
export ledger buyFeeA: Uint<16>; // basis points for contract-mediated trades
export ledger buyFeeB: Uint<16>;
export ledger sellFeeA: Uint<16>;
export ledger sellFeeB: Uint<16>;
export ledger treasuryActions: Map<Uint<32>, TreasuryAction>;
export ledger treasuryActionCount: Uint<32>;

constructor(firstRoundCloseAt: Uint<64>) {
  // Leave room for all Uint<32> weekly rounds and their one-day grace periods.
  assert(firstRoundCloseAt > 0 && firstRoundCloseAt < (9223372036854775807 as Uint<64>), "invalid first close");
  round = 1;
  roundCloseAt = disclose(firstRoundCloseAt);
  nextIndex = 0;
  phase = 0;
  winner = 2;
  targetA = 50;
  targetB = 50;
  economyIssued = false;
  reserveA = 0;
  reserveB = 0;
  feePool = 0;
  kaiDistributed = 0;
  buyFeeA = 300;
  buyFeeB = 300;
  sellFeeA = 500;
  sellFeeB = 500;
  treasuryActionCount = 0;
}

// Fixed-supply, contract-custodied genesis. Anyone may trigger the first mint,
// but no caller receives tokens and later calls cannot inflate the supply.
// Deliberately no assert: unshielded mints in fallible circuits may fail at
// ledger submission even when compilation and proof generation succeed.
export circuit initializeEconomy(): [] {
  if (!economyIssued) {
    quoteAColor = mintUnshieldedToken(
      pad(32, "kairos:quote-a:v1"),
      disclose(1000000 as Uint<64>),
      left<ContractAddress, UserAddress>(kernel.self())
    );
    quoteBColor = mintUnshieldedToken(
      pad(32, "kairos:quote-b:v1"),
      disclose(1000000 as Uint<64>),
      left<ContractAddress, UserAddress>(kernel.self())
    );
    kaiColor = mintUnshieldedToken(
      pad(32, "kairos:kai:v1"),
      disclose(1000000 as Uint<64>),
      left<ContractAddress, UserAddress>(kernel.self())
    );
    economyIssued = true;
  }
}

circuit checkFee(gross: Uint<64>, bps: Uint<16>, fee: Uint<64>): [] {
  const product = gross * bps;
  const lower = fee * (10000 as Uint<14>);
  assert(lower <= product && product < lower + (10000 as Uint<14>), "incorrect fee");
}

// Transparent, contract-mediated 1:1 NIGHT/quote route. Wallet-to-wallet
// transfers do not traverse these circuits and therefore pay no Kairos fee.
export circuit buyQuote(side: Uint<8>, grossNight: Uint<64>, fee: Uint<64>, recipient: UserAddress): [] {
  // Token type, amount, fee, and recipient are necessarily public for this
  // unshielded route; these disclosures do not apply to private market votes.
  const publicSide = disclose(side);
  const publicGross = disclose(grossNight);
  const publicFee = disclose(fee);
  assert(economyIssued, "economy is not initialized");
  assert(publicSide <= 1, "invalid quote side");
  assert(publicGross >= 100, "buy amount is too small");
  const gross = publicGross as Uint<128>;
  const feeBps = publicSide == 0 ? buyFeeA : buyFeeB;
  checkFee(publicGross, feeBps, publicFee);
  const output = gross - (publicFee as Uint<128>);
  const color = publicSide == 0 ? quoteAColor : quoteBColor;
  assert(unshieldedBalanceGte(color, disclose(output)), "insufficient quote inventory");
  receiveUnshielded(nativeToken(), gross);
  sendUnshielded(color, disclose(output), right<ContractAddress, UserAddress>(disclose(recipient)));
  // Fee-coupled, fixed-supply KAI incentive. Exhaustion never blocks a trade.
  if (unshieldedBalanceGte(kaiColor, disclose(publicFee as Uint<128>))) {
    sendUnshielded(kaiColor, disclose(publicFee as Uint<128>), right<ContractAddress, UserAddress>(disclose(recipient)));
    kaiDistributed = (kaiDistributed + (publicFee as Uint<128>)) as Uint<128>;
  }
  if (publicSide == 0) {
    reserveA = (reserveA + output) as Uint<128>;
  } else {
    reserveB = (reserveB + output) as Uint<128>;
  }
  feePool = (feePool + (publicFee as Uint<128>)) as Uint<128>;
}

export circuit sellQuote(side: Uint<8>, grossQuote: Uint<64>, fee: Uint<64>, recipient: UserAddress): [] {
  const publicSide = disclose(side);
  const publicGross = disclose(grossQuote);
  const publicFee = disclose(fee);
  assert(economyIssued, "economy is not initialized");
  assert(publicSide <= 1, "invalid quote side");
  assert(publicGross >= 100, "sell amount is too small");
  const gross = publicGross as Uint<128>;
  const feeBps = publicSide == 0 ? sellFeeA : sellFeeB;
  checkFee(publicGross, feeBps, publicFee);
  const payout = gross - (publicFee as Uint<128>);
  const color = publicSide == 0 ? quoteAColor : quoteBColor;
  assert((publicSide == 0 ? reserveA : reserveB) >= gross, "insufficient side reserve");
  assert(unshieldedBalanceGte(nativeToken(), disclose(payout)), "insufficient NIGHT balance");
  receiveUnshielded(color, gross);
  sendUnshielded(nativeToken(), disclose(payout), right<ContractAddress, UserAddress>(disclose(recipient)));
  if (unshieldedBalanceGte(kaiColor, disclose(publicFee as Uint<128>))) {
    sendUnshielded(kaiColor, disclose(publicFee as Uint<128>), right<ContractAddress, UserAddress>(disclose(recipient)));
    kaiDistributed = (kaiDistributed + (publicFee as Uint<128>)) as Uint<128>;
  }
  if (publicSide == 0) {
    reserveA = (reserveA - gross) as Uint<128>;
  } else {
    reserveB = (reserveB - gross) as Uint<128>;
  }
  feePool = (feePool + (publicFee as Uint<128>)) as Uint<128>;
}

circuit commitment(currentRound: Uint<32>, side: Uint<8>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "kairos:position:v1"),
    (currentRound as Field) as Bytes<32>,
    (side as Field) as Bytes<32>,
    salt
  ]);
}

export circuit commitPosition(expectedRound: Uint<32>, side: Uint<8>, salt: Bytes<32>): [] {
  assert(phase == 0, "round is not open");
  assert(blockTimeLt(roundCloseAt), "round is closed");
  assert(round == expectedRound, "opening belongs to another round");
  assert(nextIndex < 8, "round is full");
  assert(side <= 1, "invalid quote side");
  commitments.insert(nextIndex, disclose(commitment(round, side, salt)));
  nextIndex = (nextIndex + 1) as Uint<8>;
  if (nextIndex == 8) {
    phase = 1;
  }
}

circuit tallyOpening(acc: Tally, opening: Opening): Tally {
  assert(opening.side <= 1, "invalid quote side");
  assert(commitments.lookup(acc.index) == commitment(round, opening.side, opening.salt), "opening does not match commitment");
  return Tally {
    index: (acc.index + 1) as Uint<8>,
    forA: (acc.forA + (opening.side == 0 ? 1 : 0)) as Uint<8>,
    forB: (acc.forB + (opening.side == 1 ? 1 : 0)) as Uint<8>
  };
}

export circuit resolveRound(openings: Vector<8, Opening>, candidateA: Uint<128>): [] {
  assert(phase == 1, "round is not full");
  assert(blockTimeGte(roundCloseAt), "round is still open");
  assert(blockTimeLt((roundCloseAt + (86400 as Uint<64>)) as Uint<64>), "resolution window expired");
  const tally = fold(tallyOpening, Tally { index: 0, forA: 0, forB: 0 }, openings);
  assert(tally.index == 8, "incomplete tally");
  // The winning side is the sole disclosed result of the private tally.
  const outcome = disclose(tally.forA > tally.forB ? 0 : tally.forB > tally.forA ? 1 : 2);
  winner = outcome;
  if (outcome == 0) {
    targetA = 70;
    targetB = 30;
    buyFeeA = 100;
    buyFeeB = 500;
    sellFeeA = 300;
    sellFeeB = 700;
  } else if (outcome == 1) {
    targetA = 30;
    targetB = 70;
    buyFeeA = 500;
    buyFeeB = 100;
    sellFeeA = 700;
    sellFeeB = 300;
  }
  applyTarget(candidateA);
  phase = 2;
  recordTreasuryAction(0);
}

// Missing openings cannot keep the market stuck forever. After the one-day
// resolution window, expire without disclosing a side or changing policy.
export circuit expireRound(candidateA: Uint<128>): [] {
  assert(phase != 2, "round is already resolved");
  assert(blockTimeGte((roundCloseAt + (86400 as Uint<64>)) as Uint<64>), "resolution window is still open");
  applyTarget(candidateA);
  winner = 2;
  phase = 2;
  recordTreasuryAction(1);
}

circuit recordTreasuryAction(kind: Uint<8>): [] {
  assert(treasuryActionCount < (4294967295 as Uint<32>), "treasury history is full");
  treasuryActions.insert(treasuryActionCount, TreasuryAction {
    round: round,
    kind: kind,
    winner: winner,
    targetA: targetA,
    targetB: targetB,
    reserveA: reserveA,
    reserveB: reserveB,
    feePool: feePool
  });
  treasuryActionCount = (treasuryActionCount + 1) as Uint<32>;
}

// The caller supplies the division result, but the circuit proves it is the
// floor of total NIGHT reserve * targetA / 100. It is not an oracle input.
circuit applyTarget(candidateA: Uint<128>): [] {
  const publicCandidate = disclose(candidateA);
  const total = (reserveA + reserveB) as Uint<128>;
  const scaled = total * targetA;
  const lower = publicCandidate * (100 as Uint<7>);
  assert(lower <= scaled && scaled < lower + (100 as Uint<7>), "incorrect target allocation");
  reserveA = publicCandidate;
  reserveB = (total - publicCandidate) as Uint<128>;
}

// After resolution, trades may disturb the target ratio. Anyone can restore it.
export circuit rebalanceTreasury(candidateA: Uint<128>): [] {
  assert(phase == 2, "round is not resolved");
  const beforeA = reserveA;
  const beforeB = reserveB;
  applyTarget(candidateA);
  assert(reserveA != beforeA || reserveB != beforeB, "target is already applied");
  recordTreasuryAction(2);
}

export circuit startNextRound(): [] {
  assert(phase == 2, "current round is unresolved");
  // A new round cannot bypass the resolved treasury policy. Reapply it after
  // any intervening trades that changed the reserve ratio.
  const total = (reserveA + reserveB) as Uint<128>;
  const scaled = total * targetA;
  const lower = reserveA * (100 as Uint<7>);
  assert(lower <= scaled && scaled < lower + (100 as Uint<7>), "treasury target is not applied");
  commitments.resetToDefault();
  nextIndex = 0;
  round = (round + 1) as Uint<32>;
  roundCloseAt = (roundCloseAt + (604800 as Uint<64>)) as Uint<64>;
  winner = 2;
  phase = 0;
}

# Browser-visible. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# Used by local developer scripts. A user's private proving inputs should only go
# to a local or otherwise controlled proof server.
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Add server-only application secrets below without NEXT_PUBLIC_ prefixes.
# EXAMPLE_SERVER_SECRET=

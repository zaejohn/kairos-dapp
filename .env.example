# KAIROS environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored — keep it that
# way. Nothing here is a secret: these are public endpoints and a public
# contract address. Never put a seed phrase, mnemonic or private key in this
# file.
#
#   cp .env.example .env.local

# Which Midnight network to target: preprod | preview | undeployed
# Preprod is the public testnet the Midnight docs recommend for development.
NEXT_PUBLIC_NETWORK_ID=preprod

# Address of the deployed KAIROS contract.
#
# Leave this EMPTY for the first run: the app detects that no contract is
# configured and offers a "Deploy KAIROS contract" button instead. After
# deploying, paste the address shown in the app's footer here and restart the
# dev server.
#
# Do not invent an address. It is only ever set from a real deployment.
NEXT_PUBLIC_KAIROS_CONTRACT_ADDRESS=

# Local proof server. KAIROS proves here on every wallet so that the witness
# data behind your position never leaves your machine.
#
# Not read by the app directly — the endpoint lives in src/lib/midnight/network.ts
# — but recorded here so the expected value is documented in one place.
# KAIROS_PROOF_SERVER=http://localhost:6300
